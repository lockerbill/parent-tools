# Copy to .env next to docker-compose.yml and adjust what you need.

# Optional override. If empty, HomeDojo generates the signing key once and
# keeps it in the persistent storage volume.
# SECRET_KEY_BASE=

# Your timezone; controls how days and weeks are grouped in reports.
TZ=Australia/Perth

# Host and port you actually reach the app on. Used in emailed links.
APP_HOST=homedojo.lan:3000

# Set to 1 only when a reverse proxy terminates TLS in front of HomeDojo.
# FORCE_SSL=1

# Comma-separated hostnames allowed to reach the app. Leave unset on a LAN.
# APP_HOSTS=homedojo.lan,homedojo.tail1234.ts.net

# Optional SMTP. Without these, HomeDojo sends no email at all.
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USER_NAME=homedojo@example.com
# SMTP_PASSWORD=
# SMTP_STARTTLS=true
# MAIL_FROM=homedojo@example.com
