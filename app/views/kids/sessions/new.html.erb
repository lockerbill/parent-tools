<% page_title "Kid view" %>

<% if @child %>
  <div class="mx-auto max-w-xs text-center">
    <%= render "shared/avatar", child: @child, size: :xl %>
    <h1 class="mt-3 text-2xl font-bold tracking-tight"><%= @child.name %></h1>

    <% if @child.pin? %>
      <p class="mt-1 text-sm text-slate-600">Type your PIN</p>

      <%= form_with url: kids_session_path, data: { controller: "pin-pad" }, class: "mt-4" do %>
        <%= hidden_field_tag :child_id, @child.id %>
        <%= hidden_field_tag :pin, "", data: { pin_pad_target: "input" } %>

        <div class="mb-4 flex justify-center gap-2" data-pin-pad-target="dots">
          <% 6.times do |index| %>
            <span data-index="<%= index %>" class="h-3 w-3 rounded-full bg-slate-300"></span>
          <% end %>
        </div>

        <div class="grid grid-cols-3 gap-3">
          <% (1..9).each do |digit| %>
            <button type="button" data-action="pin-pad#press" data-digit="<%= digit %>"
                    class="h-16 rounded-2xl bg-white text-2xl font-bold text-slate-800 shadow-sm ring-1 ring-slate-200 active:scale-95">
              <%= digit %>
            </button>
          <% end %>
          <button type="button" data-action="pin-pad#clear" class="h-16 rounded-2xl text-sm font-semibold text-slate-500">Clear</button>
          <button type="button" data-action="pin-pad#press" data-digit="0"
                  class="h-16 rounded-2xl bg-white text-2xl font-bold text-slate-800 shadow-sm ring-1 ring-slate-200 active:scale-95">0</button>
          <button type="submit" class="h-16 rounded-2xl bg-slate-900 text-sm font-semibold text-white active:scale-95">Go</button>
        </div>
      <% end %>
    <% else %>
      <%= button_to "Open my dojo", kids_session_path, params: { child_id: @child.id }, class: "btn-primary mt-6 w-full py-4 text-lg" %>
    <% end %>

    <p class="mt-6">
      <%= link_to "← Someone else", kids_root_path, class: "text-sm text-slate-500" %>
    </p>
  </div>
<% else %>
  <div class="text-center">
    <h1 class="text-2xl font-bold tracking-tight">Who's here?</h1>
    <p class="mt-1 text-sm text-slate-600">Tap your name.</p>
  </div>

  <% if @children.empty? %>
    <div class="card mt-6 text-center text-sm text-slate-500">No children yet.</div>
  <% else %>
    <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3">
      <% @children.each do |child| %>
        <%= link_to kids_root_path(child_id: child.id),
              class: "card flex flex-col items-center gap-2 py-6 transition active:scale-95" do %>
          <%= render "shared/avatar", child: child, size: :lg %>
          <span class="text-base font-bold"><%= child.name %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>

  <p class="mt-10 text-center">
    <%= link_to "Parent sign in", new_session_path, class: "text-xs text-slate-400" %>
  </p>
<% end %>
