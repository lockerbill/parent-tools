<% page_title @child.name %>

<div class="text-center">
  <%= render "shared/avatar", child: @child, size: :xl %>
  <h1 class="mt-3 text-xl font-bold tracking-tight"><%= @child.name %></h1>
  <p class="mt-2 text-7xl font-black tabular-nums text-indigo-600"><%= @child.points_balance %></p>
  <p class="text-sm font-medium text-slate-500">points</p>
  <p class="mt-1 text-sm text-slate-500">
    <%= signed_points(@report.this_week_net) %> this week
  </p>
</div>

<section class="mt-8">
  <h2 class="section-title">What you can swap points for</h2>
  <% if @rewards.empty? %>
    <div class="card text-center text-sm text-slate-500">No rewards yet.</div>
  <% else %>
    <div class="grid grid-cols-2 gap-3">
      <% @rewards.each do |reward| %>
        <% affordable = reward.affordable_for?(@child) %>
        <div class="card flex flex-col items-center gap-1 text-center <%= "opacity-60" unless affordable %>">
          <span class="text-3xl" aria-hidden="true"><%= reward.icon %></span>
          <span class="text-sm font-semibold leading-tight"><%= reward.name %></span>
          <span class="text-xs font-bold tabular-nums text-slate-500"><%= reward.cost %> points</span>

          <% if current_family.kid_requests_enabled? %>
            <%= button_to "Ask", kids_redemptions_path, params: { reward_id: reward.id },
                  disabled: !affordable, form_class: "mt-1 w-full",
                  class: "w-full rounded-xl px-3 py-2 text-sm font-semibold #{affordable ? "bg-indigo-600 text-white" : "bg-slate-100 text-slate-400"}" %>
          <% elsif !affordable %>
            <span class="mt-1 text-xs text-slate-400"><%= reward.cost - @child.points_balance %> to go</span>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<% if @redemptions.any? %>
  <section class="mt-8">
    <h2 class="section-title">Your swaps</h2>
    <ul class="card divide-y divide-slate-100 p-0">
      <% @redemptions.each do |redemption| %>
        <li class="flex items-center gap-3 px-4 py-3">
          <span class="text-xl" aria-hidden="true"><%= redemption.reward.icon %></span>
          <p class="min-w-0 flex-1 truncate text-sm font-medium"><%= redemption.reward.name %></p>
          <span class="text-xs font-semibold <%= redemption.denied? ? "text-rose-500" : redemption.requested? ? "text-amber-600" : "text-emerald-600" %>">
            <%= redemption.requested? ? "waiting" : redemption.status.humanize.downcase %>
          </span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section class="mt-8">
  <h2 class="section-title">Lately</h2>
  <% if @recent_events.empty? %>
    <div class="card text-center text-sm text-slate-500">Nothing yet.</div>
  <% else %>
    <ul class="card divide-y divide-slate-100 p-0">
      <% @recent_events.each do |event| %>
        <li class="flex items-center gap-3 px-4 py-3">
          <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-xl ring-1 <%= chip_classes(event.color) %>" aria-hidden="true">
            <%= event.icon %>
          </span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-medium"><%= event.label %></p>
            <p class="text-xs text-slate-500"><%= friendly_time(event.occurred_at) %></p>
          </div>
          <span class="text-base font-bold tabular-nums <%= event.positive? ? "text-emerald-600" : "text-rose-600" %>"><%= event.signed_points %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<div class="mt-10 text-center">
  <%= button_to "Done", kids_session_path, method: :delete, class: "btn-secondary" %>
</div>
