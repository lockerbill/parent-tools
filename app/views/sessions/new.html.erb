<% page_title "Sign in" %>

<div class="mx-auto max-w-sm py-10">
  <div class="mb-6 text-center">
    <div class="text-4xl" aria-hidden="true">🥋</div>
    <h1 class="mt-2 text-xl font-bold tracking-tight"><%= current_family&.name || "HomeDojo" %></h1>
  </div>

  <%= form_with url: session_path, class: "card space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, "Email address", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "field" %>
    </div>

    <div>
      <%= form.label :password, "Password", class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", class: "field" %>
    </div>

    <%= form.submit "Sign in", class: "btn-primary w-full" %>
  <% end %>

  <div class="mt-4 flex justify-between text-sm">
    <%= link_to "Forgot password?", new_password_path, class: "text-slate-500 hover:text-slate-900" %>
    <% if current_family&.kid_view_enabled? %>
      <%= link_to "Kid view →", kids_root_path, class: "font-medium text-slate-700 hover:text-slate-900" %>
    <% end %>
  </div>
</div>
