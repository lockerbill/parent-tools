<turbo-frame id="modal">
  <div data-controller="modal" class="fixed inset-0 z-40 flex items-end justify-center sm:items-center">
    <div class="absolute inset-0 bg-slate-900/50" data-action="click->modal#close"></div>

    <div class="relative z-10 max-h-[85vh] w-full max-w-lg overflow-y-auto rounded-t-2xl bg-white p-4 shadow-xl sm:rounded-2xl"
         role="dialog" aria-modal="true">
      <div class="mb-3 flex items-center gap-2">
        <h2 class="text-lg font-semibold"><%= title %></h2>
        <button type="button" data-action="modal#close"
                class="ml-auto rounded-lg px-2 py-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700" aria-label="Close">✕</button>
      </div>

      <%= yield %>
    </div>
  </div>
</turbo-frame>
