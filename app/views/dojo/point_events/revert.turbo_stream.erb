<%= turbo_stream.update "children" do %>
  <%= render partial: "dojo/dashboard/child_card", collection: @children, as: :child %>
<% end %>

<%= turbo_stream.update "activity_feed" do %>
  <%= render "dojo/point_events/feed", events: @recent_events %>
<% end %>

<% @events.each do |event| %>
  <%= turbo_stream.replace dom_id(event) do %>
    <%= render "dojo/point_events/event", event: event %>
  <% end %>

  <%= turbo_stream.replace dom_id(event.child, :balance) do %>
    <%= render "dojo/children/balance", child: event.child.reload %>
  <% end %>
<% end %>

<%= turbo_stream.append "toasts" do %>
  <%= render "shared/toast", type: :notice, message: "Undone — #{@event.child.name} is back to #{@event.child.points_balance} points." %>
<% end %>
