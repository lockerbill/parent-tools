<% page_title "Children" %>

<div class="mb-4 flex items-center justify-between">
  <h1 class="text-lg font-bold tracking-tight">Children</h1>
  <%= link_to "Add a child", new_dojo_child_path, class: "btn-primary" %>
</div>

<% active, archived = @children.partition { |child| !child.archived? } %>

<% if active.empty? %>
  <div class="card text-center text-sm text-slate-500">No children yet.</div>
<% else %>
  <ul class="card divide-y divide-slate-100 p-0">
    <% active.each do |child| %>
      <li class="flex items-center gap-3 px-4 py-3">
        <%= render "shared/avatar", child: child, size: :sm %>
        <div class="min-w-0 flex-1">
          <p class="truncate text-sm font-semibold"><%= child.name %></p>
          <p class="text-xs text-slate-500">
            <%= pluralize child.points_balance, "point" %>
            <% if child.age %>· <%= child.age %> years old<% end %>
            <% if child.pin? %>· PIN set<% end %>
          </p>
        </div>
        <%= link_to "Report", report_dojo_child_path(child), class: "btn-ghost" %>
        <%= link_to "Edit", edit_dojo_child_path(child), class: "btn-ghost" %>
      </li>
    <% end %>
  </ul>
<% end %>

<% if archived.any? %>
  <h2 class="section-title mt-8">Archived</h2>
  <ul class="card divide-y divide-slate-100 p-0">
    <% archived.each do |child| %>
      <li class="flex items-center gap-3 px-4 py-3 opacity-70">
        <%= render "shared/avatar", child: child, size: :sm %>
        <p class="flex-1 truncate text-sm font-semibold"><%= child.name %></p>
        <%= button_to "Restore", restore_dojo_child_path(child), class: "btn-secondary px-3 py-1.5" %>
      </li>
    <% end %>
  </ul>
<% end %>
