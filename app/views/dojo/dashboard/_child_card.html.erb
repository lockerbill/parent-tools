<div id="<%= dom_id(child) %>" class="card relative flex flex-col items-center p-3 text-center"
     data-multi-select-target="card">
  <label class="absolute left-2 top-2 flex h-8 w-8 cursor-pointer items-center justify-center rounded-lg hover:bg-slate-100">
    <input type="checkbox" name="child_ids[]" value="<%= child.id %>"
           data-multi-select-target="checkbox" data-action="change->multi-select#update"
           class="h-5 w-5 rounded border-slate-300 text-slate-900 focus:ring-slate-900"
           aria-label="Select <%= child.name %>">
  </label>

  <%= link_to new_dojo_point_event_path(child_id: child.id), data: { turbo_frame: "modal" },
        class: "flex w-full flex-col items-center gap-2 pt-6" do %>
    <%= render "shared/avatar", child: child, size: :lg %>
    <span class="line-clamp-1 w-full text-sm font-semibold"><%= child.name %></span>
    <span class="text-3xl font-black tabular-nums <%= child.points_balance.negative? ? "text-rose-600" : "text-slate-900" %>">
      <%= child.points_balance %>
    </span>
  <% end %>

  <div class="mt-2 flex w-full items-center justify-center gap-1 text-xs">
    <%= link_to "Details", dojo_child_path(child), class: "rounded px-2 py-1 text-slate-500 hover:bg-slate-100" %>
    <%= link_to "Report", report_dojo_child_path(child), class: "rounded px-2 py-1 text-slate-500 hover:bg-slate-100" %>
  </div>
</div>
